# Environment variables for GitHub Issue Intelligence
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file — it is listed in .gitignore.

# ----------------------------------------------------------------
# GitHub API
# ----------------------------------------------------------------
# Personal Access Token (classic or fine-grained) with public repo
# read access. Used by data collection scripts.
# Create one at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# ----------------------------------------------------------------
# (Future) Model / API keys
# ----------------------------------------------------------------
# Uncomment and fill in when needed in later stages.
# OPENAI_API_KEY=your_openai_key_here
# HF_TOKEN=your_huggingface_token_here
